{
  "name": "hotel-police-collaboration-system",
  "version": "1.0.0",
  "description": "A comprehensive smart contract system for hotel-police collaboration with guest verification, access control, data storage, and alert management",
  "author": "Hotel-Police Collaboration System Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/hotel-police-system.git"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "smart-contracts",
    "hotel",
    "police",
    "collaboration",
    "access-control",
    "data-storage",
    "security",
    "verification"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "clean": "rm -rf artifacts cache coverage typechain-types deployments .nyc_output",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:unit": "hardhat test ./test/unit",
    "test:integration": "hardhat test ./test/integration",
    "test:security": "hardhat test ./test/security",
    "test:edge-cases": "hardhat test ./test/edge-cases",
    "test:all": "hardhat test --parallel",
    "test:coverage": "hardhat coverage --temp artifacts",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:debug": "NODE_DEBUG=hardhat hardhat test",
    "deploy": "hardhat deploy",
    "deploy:localhost": "hardhat deploy --network localhost",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "deploy:mainnet": "hardhat deploy --network mainnet",
    "verify": "hardhat verify --network mainnet",
    "verify:sepolia": "hardhat verify --network sepolia",
    "lint": "solhint 'contracts/**/*.sol' && eslint '**/*.js'",
    "lint:fix": "solhint --fix 'contracts/**/*.sol' && eslint --fix '**/*.js'",
    "format": "prettier --write '**/*.{js,json,sol,md}'",
    "format:check": "prettier --check '**/*.{js,json,sol,md}'",
    "gas-report": "hardhat run scripts/gas-report.js",
    "node": "node",
    "hardhat": "hardhat",
    "start": "hardhat node",
    "dev": "concurrently \"npm run start\" \"npm run test:debug\"",
    "docs": "hardhat export-abi && hardhat generate-docs",
    "docs:abi": "hardhat export-abi",
    "docs:generate": "hardhat generate-docs"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "chai": "^4.3.10",
    "ethers": "^6.9.0",
    "hardhat": "^2.19.0",
    "hardhat-deploy": "^0.11.45",
    "hardhat-gas-reporter": "^1.0.9",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.9",
    "@types/mocha": "^10.0.3",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^4.0.0",
    "solhint-plugin-prettier": "^0.0.5",
    "tsconfig-paths": "^4.2.0",
    "typechain": "^8.3.1"
  },
  "resolutions": {
    "@types/node": "^20.9.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "@nomicfoundation/hardhat-chai-matchers": {
      "@nomicfoundation/hardhat-network-helpers": "^1.0.0"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test:unit",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.sol": [
      "solhint --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "semi": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "printWidth": 120,
    "overrides": [
      {
        "files": "*.sol",
        "options": {
          "tabWidth": 4,
          "printWidth": 120
        }
      }
    ]
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "import",
      "promise",
      "unused-imports"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/typescript",
      "plugin:promise/recommended",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        { "argsIgnorePattern": "^_" }
      ],
      "@typescript-eslint/explicit-function-return-type": "off",
      "@typescript-eslint/explicit-module-boundary-types": "off",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/no-non-null-assertion": "warn",
      "import/order": [
        "error",
        {
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index"
          ],
          "newlines-between": "always"
        }
      ],
      "no-console": "warn",
      "no-debugger": "error",
      "no-process-exit": "error",
      "prefer-const": "error",
      "prefer-spread": "error",
      "no-var": "error",
      "promise/always-return": "off",
      "unused-imports/no-unused-imports": "error",
      "import/no-unresolved": "off"
    },
    "ignorePatterns": [
      "node_modules/",
      "artifacts/",
      "cache/",
      "coverage/",
      "deployments/",
      "typechain-types/",
      "dist/",
      ".nyc_output/",
      "*.d.ts"
    ]
  },
  "files": [
    "hardhat.config.js",
    "scripts/",
    "test/",
    "contracts/"
  ],
  "manfiles": [
    "package.json"
  ],
  "pnpm": {
    "overrides": {
      "@types/node": "^20.9.0"
    }
  }
}
