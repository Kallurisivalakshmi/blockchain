		"devdoc": {
			"details": "Interface for Data Storage Contract",
			"events": {
				"DataDeleted(string,address,uint256)": {
					"details": "Event emitted when data is deleted",
					"params": {
						"dataId": "Unique data identifier",
						"deletedBy": "Address that deleted the data",
						"timestamp": "Deletion timestamp"
					}
				},
				"DataRetrieved(string,address,uint256)": {
					"details": "Event emitted when data is retrieved",
					"params": {
						"dataId": "Unique data identifier",
						"retrievedBy": "Address that retrieved the data",
						"timestamp": "Retrieval timestamp"
					}
				},
				"DataStored(string,string,uint8,string)": {
					"details": "Event emitted when data is stored",
					"params": {
						"dataId": "Unique data identifier",
						"dataType": "Type of data stored",
						"guestId": "Guest ID this data belongs to",
						"ipfsHash": "IPFS hash of the data"
					}
				},
				"RetentionUpdated(string,uint256,address)": {
					"details": "Event emitted when data retention is updated",
					"params": {
						"dataId": "Unique data identifier",
						"newRetentionPeriod": "New retention period in seconds",
						"updatedBy": "Address that updated the retention"
					}
				}
			},
			"kind": "dev",
			"methods": {
				"dataExists(string)": {
					"details": "Check if data exists",
					"params": {
						"dataId": "Unique data identifier"
					},
					"returns": {
						"exists": "Whether data exists"
					}
				},
				"deleteData(string)": {
					"details": "Delete data reference and mark for cleanup",
					"params": {
						"dataId": "Unique data identifier"
					},
					"returns": {
						"success": "Whether deletion was successful"
					}
				},
				"getGuestDataByType(string,uint8)": {
					"details": "Get data references by type for a guest",
					"params": {
						"dataType": "Type of data to filter by",
						"guestId": "Guest ID to query"
					},
					"returns": {
						"dataIds": "Array of data identifiers matching criteria"
					}
				},
				"getGuestDataReferences(string)": {
					"details": "Get all data references for a specific guest",
					"params": {
						"guestId": "Guest ID to query"
					},
					"returns": {
						"dataIds": "Array of data identifiers"
					}
				},
				"getIPFSHash(string)": {
					"details": "Get the IPFS hash for a specific data ID",
					"params": {
						"dataId": "Unique data identifier"
					},
					"returns": {
						"ipfsHash": "IPFS hash of the data"
					}
				},
				"isDataExpired(string)": {
					"details": "Check if data has expired and should be deleted",
					"params": {
						"dataId": "Unique data identifier"
					},
					"returns": {
						"isExpired": "Whether data has expired"
					}
				},
				"storeData(string,uint8,string,uint256,string,string,uint256)": {
					"details": "Store data reference with IPFS hash",
					"params": {
						"dataType": "Type of data being stored",
						"encryptionAlgorithm": "Encryption algorithm used",
						"encryptionKeyHash": "Hash of the encryption key",
						"guestId": "Guest ID this data belongs to",
						"ipfsHash": "IPFS hash of the encrypted data",
						"retentionPeriod": "How long data should be retained (seconds)",
						"size": "Size of the data in bytes"
					},
					"returns": {
						"dataId": "Unique data identifier"
					}
				},
				"updateRetention(string,uint256)": {
					"details": "Update retention period for data",
					"params": {
						"dataId": "Unique data identifier",
						"newRetentionPeriod": "New retention period in seconds"
					},
					"returns": {
						"success": "Whether update was successful"
					}
				},
				"verifyDataIntegrity(string,string)": {
					"details": "Verify data integrity by checking hash",
					"params": {
						"dataId": "Unique data identifier",
						"expectedHash": "Expected IPFS hash"
					},
					"returns": {
						"isValid": "Whether data integrity is valid"
					}
				}
